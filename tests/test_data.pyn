import pytest
import torch
from torch import Tensor

from data import get_batch, split


@pytest.fixture
def ids():
    return torch.arange(100)


def test_split_sizes(ids: Tensor):
    (train=, val=) = split(ids)
    assert (len(train), len(val)) == (90, 10)


def test_split_rejoins_in_order(ids: Tensor):
    (train=, val=) = split(ids, frac=0.75)
    assert torch.equal(torch.cat([train, val]), ids)


def test_batch_shape(ids: Tensor):
    x, y = get_batch(ids, batch_size=4, block_size=8)
    assert x.shape == y.shape == (4, 8)
    assert x.dtype == y.dtype == ids.dtype


def test_y_is_x_shifted_by_one(ids: Tensor):
    x, y = get_batch(ids, batch_size=16, block_size=8)
    assert torch.equal(y[:, :-1], x[:, 1:])
    assert torch.equal(y, x + 1)  # only works because ids is arange


def test_rows_are_contiguous_slices(ids: Tensor):
    x, _ = get_batch(ids, batch_size=16, block_size=8)
    first = x[:, :1]
    assert torch.equal(x, first + torch.arange(8))


def test_windows_stay_inside(ids: Tensor):
    block_size = len(ids) - 1
    only_x, only_y = ids[:-1], ids[1:]
    x, y = get_batch(ids, batch_size=1000, block_size=block_size)
    assert torch.equal(x, only_x.expand_as(x))
    assert torch.equal(y, only_y.expand_as(y))


def test_needs_more_ids_than_block_size(ids: Tensor):
    with pytest.raises(
        AssertionError, match="need more than block_size 100 ids, got 100"
    ):
        get_batch(ids, batch_size=1, block_size=len(ids))
