# split and get_batch, on arange data. Each id equals its position, so a slice's
# values show exactly where it was cut from
import pytest
import torch
from torch import Tensor

from data import get_batch, split


@pytest.fixture
def ids():
    return torch.arange(100)  # [100], 0, 1, ..., 99


def test_split_sizes(ids: Tensor):
    (train_data=, val_data=) = split(ids)  # [90], [10]
    assert (len(train_data), len(val_data)) == (90, 10)


def test_split_rejoins_in_order(ids: Tensor):
    (train_data=, val_data=) = split(ids, frac=0.75)  # [75], [25]
    assert torch.equal(
        torch.cat([train_data, val_data]), ids
    )  # no shuffle, overlap or loss


def test_batch_shape(ids: Tensor):
    x, y = get_batch(ids, batch_size=4, block_size=8)  # each [4, 8]
    assert x.shape == y.shape == (4, 8)
    assert x.dtype == y.dtype == ids.dtype


def test_y_is_x_shifted_by_one(ids: Tensor):
    x, y = get_batch(ids, batch_size=16, block_size=8)  # each [16, 8]
    assert torch.equal(y[:, :-1], x[:, 1:])
    assert torch.equal(y, x + 1)  # arange, so the next id is always the current id + 1


def test_rows_are_contiguous_slices(ids: Tensor):
    x, _ = get_batch(ids, batch_size=16, block_size=8)  # [16, 8]
    # each row is its first id followed by the next 7
    first = x[:, :1]  # [16, 1]
    assert torch.equal(x, first + torch.arange(8))


def test_windows_stay_inside(ids: Tensor):
    # block_size = N - 1 leaves exactly one valid start (0), so all 1000 samples
    # must be that window; reading past the end would break this
    block_size = len(ids) - 1
    only_x, only_y = ids[:-1], ids[1:]  # each [99]
    x, y = get_batch(ids, batch_size=1000, block_size=)  # each [1000, 99]
    assert torch.equal(x, only_x.expand_as(x))
    assert torch.equal(y, only_y.expand_as(y))


def test_needs_more_ids_than_block_size(ids: Tensor):
    with pytest.raises(
        AssertionError, match="need more than block_size 100 ids, got 100"
    ):
        get_batch(ids, batch_size=1, block_size=len(ids))
