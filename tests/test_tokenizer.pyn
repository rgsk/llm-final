# CharTokenizer: vocab order, ids, round trip, unseen characters
from pathlib import Path

import pytest

from paths import SHAKESPEARE
from tokenizer import CharTokenizer


@pytest.fixture
def tok():
    return CharTokenizer("hello world")


def test_vocab_is_sorted_distinct_chars(tok: CharTokenizer):
    # repeated "l" and "o" appear once; " " sorts before letters
    assert tok.itoc == [" ", "d", "e", "h", "l", "o", "r", "w"]
    assert tok.vocab_size == 8


def test_ids_follow_sorted_order(tok: CharTokenizer):
    assert tok.encode(" dehlorw") == list(range(8))
    assert tok.encode("hello") == [3, 2, 4, 4, 5]  # h=3 e=2 l=4 o=5


@pytest.mark.parametrize("s", ["", "h", "hello world", "world hello  ", "lll"])
def test_roundtrip(tok: CharTokenizer, s: str):
    assert tok.decode(tok.encode(s)) == s


def test_unseen_char_raises(tok: CharTokenizer):
    with pytest.raises(KeyError):
        tok.encode("hello!")


def test_from_file_matches_text(tmp_path: Path):
    path = tmp_path / "t.txt"
    path.write_text("abcab\n")
    assert CharTokenizer.from_file(path).itoc == CharTokenizer("abcab\n").itoc


def test_shakespeare():
    text = SHAKESPEARE.read_text()
    tok = CharTokenizer(text)
    assert tok.vocab_size == 65  # letters, digit 3, punctuation, space, newline
    head = text[:10_000]
    assert tok.decode(tok.encode(head)) == head
