# GPT top to bottom: output shapes, causality, dropout, parameter counts per
# component, init, and that it can learn at all
import math

import pytest
import torch
import torch.nn.functional as F
from torch import Tensor, nn

from model import GPT, FeedForward, FlashAttention, GPTConfig, ResidualProj


def random_ids(cfg: GPTConfig, *, batch_size: int = 3) -> Tensor:
    # out: [B, T]
    return torch.randint(cfg.vocab_size, (batch_size, cfg.block_size))


def test_logits_shape(model: GPT, cfg: GPTConfig):
    ids = random_ids(cfg, batch_size=3)  # [3, T]
    logits = model(ids)  # [3, T, V]
    assert logits.shape == (3, cfg.block_size, cfg.vocab_size)


def test_shorter_than_block_size(model: GPT, cfg: GPTConfig):
    ids = random_ids(cfg)[:, :5]  # [3, 5]
    assert model(ids).shape == (3, 5, cfg.vocab_size)


def test_longer_than_block_size_fails(model: GPT, cfg: GPTConfig):
    too_long = torch.zeros(1, cfg.block_size + 1, dtype=torch.long)  # [1, T + 1]
    with pytest.raises(AssertionError, match="sequence length 9 exceeds block_size 8"):
        model(too_long)


def test_causal(model: GPT, cfg: GPTConfig):
    # change the token at pos: logits before pos must not move, the rest must
    pos = cfg.block_size // 2  # mid-sequence: positions on both sides
    ids = random_ids(cfg)  # [B, T]
    changed = ids.clone()
    changed[:, pos] = (changed[:, pos] + 1) % cfg.vocab_size

    before, after = model(ids), model(changed)  # each [B, T, V]

    assert torch.equal(before[:, :pos], after[:, :pos])
    assert not torch.allclose(before[:, pos:], after[:, pos:])


@pytest.fixture
def dropout_model(cfg: GPTConfig) -> GPT:
    return GPT(cfg._replace(dropout=0.5))


def test_dropout_is_random_in_train_mode(dropout_model: GPT, cfg: GPTConfig):
    ids = random_ids(cfg)  # [B, T]
    dropout_model.train()
    assert not torch.equal(dropout_model(ids), dropout_model(ids))


def test_dropout_is_off_in_eval_mode(dropout_model: GPT, cfg: GPTConfig):
    # covers the attention weights too: dropout_p there is zeroed by hand
    ids = random_ids(cfg)  # [B, T]
    dropout_model.eval()
    assert torch.equal(dropout_model(ids), dropout_model(ids))


def test_zero_dropout_is_deterministic_in_train_mode(model: GPT, cfg: GPTConfig):
    ids = random_ids(cfg)  # [B, T]
    model.train()
    assert torch.equal(model(ids), model(ids))


def test_device_follows_to(model: GPT):
    assert model.device == torch.device("cpu")
    # the meta device holds shapes but no data: moves without a GPU
    model.to("meta")
    assert model.device == torch.device("meta")


def test_attention_heads_split_n_embed_evenly():
    with pytest.raises(AssertionError, match="n_embed 30 not divisible by n_head 4"):
        FlashAttention(n_embed=30, n_head=4, dropout=0.0)


def n_params(module: nn.Module) -> int:
    return sum(p.numel() for p in module.parameters())


def linear_params(n_in: int, n_out: int, *, bias: bool = True) -> int:
    return n_in * n_out + (n_out if bias else 0)


def attention_params(E: int) -> int:
    qkv = linear_params(E, 3 * E, bias=False)
    proj = linear_params(E, E)
    return qkv + proj


def test_attention_params(cfg: GPTConfig):
    attn = FlashAttention(n_embed=cfg.n_embed, n_head=cfg.n_head, dropout=cfg.dropout)
    assert n_params(attn) == attention_params(cfg.n_embed)


def feed_forward_params(E: int) -> int:
    up = linear_params(E, 4 * E)
    down = linear_params(4 * E, E)
    return up + down


def test_feed_forward_params(cfg: GPTConfig):
    ffwd = FeedForward(n_embed=cfg.n_embed, dropout=cfg.dropout)
    assert n_params(ffwd) == feed_forward_params(cfg.n_embed)


def layer_norm_params(E: int) -> int:
    weight, bias = E, E
    return weight + bias


def block_params(E: int) -> int:
    ln1, ln2 = layer_norm_params(E), layer_norm_params(E)
    return ln1 + attention_params(E) + ln2 + feed_forward_params(E)


def test_block_params(model: GPT, cfg: GPTConfig):
    for block in model.blocks:
        assert n_params(block) == block_params(cfg.n_embed)


def test_lm_head_tied_to_embedding(model: GPT):
    assert model.lm_head.weight is model.token_embedding_table.weight


def test_gpt_params(model: GPT, cfg: GPTConfig):
    (vocab_size=V, block_size=T, n_embed=E, n_layer=L) = cfg
    token_embedding = V * E
    position_embedding = T * E
    blocks = L * block_params(E)
    final_norm = layer_norm_params(E)
    lm_head = 0  # tied to token_embedding, counted once
    assert n_params(model) == (
        token_embedding + position_embedding + blocks + final_norm + lm_head
    )


def test_residual_projections_start_smaller():
    # wide layers so each weight matrix's sample std lands within 5% of the target
    cfg = (
        vocab_size=20, block_size=16, n_embed=256, n_head=4, n_layer=8, dropout=0.0
    )
    model = GPT(cfg)
    std = 0.02
    residual_std = std / math.sqrt(2 * cfg.n_layer)
    for m in model.modules():
        # lm_head's weight is the token embedding, initialized by the Embedding branch
        if isinstance(m, nn.Linear) and m is not model.lm_head:
            expected = residual_std if isinstance(m, ResidualProj) else std
            assert m.weight.std().item() == pytest.approx(expected, rel=0.05), m
            assert m.bias is None or not m.bias.any()


def test_overfits_one_batch(model: GPT, cfg: GPTConfig):
    # random targets have no pattern, so loss -> 0 means the model memorized them:
    # forward, loss, backward and optimizer step all work end to end
    x, y = random_ids(cfg, batch_size=4), random_ids(cfg, batch_size=4)  # each [B, T]
    opt = torch.optim.AdamW(model.parameters(), lr=1e-2)

    def loss():
        logits = model(x)  # [B, T, V]
        B, T, V = logits.shape
        return F.cross_entropy(logits.view(B * T, V), y.view(B * T))  # []

    for _ in range(150):
        opt.zero_grad()
        loss().backward()
        opt.step()
    assert loss().item() < 0.05
