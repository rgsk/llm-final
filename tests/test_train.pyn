# losses, evaluation and the training loop, on a tiny GPT
import math
from itertools import pairwise

import pytest
import torch
import torch.nn.functional as F
from torch import Tensor

from data import get_batch, split
from model import GPT, GPTConfig
from train import (
    TrainConfig,
    autocast,
    batch_loss,
    full_val_loss,
    lr_at,
    param_groups,
    sampled_train_loss,
    train,
)


def test_untrained_loss_is_uniform_guess(model: GPT, cfg: GPTConfig, ids: Tensor):
    x, y = get_batch(ids, batch_size=16, block_size=cfg.block_size)  # each [B, T]
    uniform = math.log(cfg.vocab_size)
    assert batch_loss(model, x, y).item() == pytest.approx(uniform, abs=0.1)


def test_batch_loss_is_mean_over_every_position(
    model: GPT, cfg: GPTConfig, ids: Tensor
):
    x, y = get_batch(ids, batch_size=3, block_size=cfg.block_size)  # each [B, T]
    logits = model(x)  # [B, T, V]
    B, T = x.shape
    per_position = [  # B*T losses, each []
        F.cross_entropy(logits[b, t], y[b, t])  # [V] vs []
        for b in range(B)
        for t in range(T)
    ]
    expected = torch.stack(per_position).mean()  # []
    assert batch_loss(model, x, y).item() == pytest.approx(expected.item(), rel=1e-5)


def test_autocast_is_off_on_cpu(model: GPT, cfg: GPTConfig):
    x = torch.randint(cfg.vocab_size, (2, cfg.block_size), device="cpu")  # [B, T]
    with autocast(x.device):
        assert model(x).dtype == torch.float32


@pytest.mark.skipif(not torch.cuda.is_available(), reason="bf16 autocast is GPU-only")
def test_batch_loss_runs_in_bf16_on_gpu(model: GPT, cfg: GPTConfig, ids: Tensor):
    model.to("cuda")
    x, y = get_batch(ids, batch_size=16, block_size=cfg.block_size, device="cuda")
    # record the dtype the logits come out in, inside batch_loss
    logit_dtypes: list[torch.dtype] = []
    model.lm_head.register_forward_hook(
        lambda _module, _inputs, out: logit_dtypes.append(out.dtype)
    )
    loss = batch_loss(model, x, y)
    assert logit_dtypes == [torch.bfloat16]
    # same forward without autocast: fp32 throughout
    logits = model(x)  # [B, T, V]
    B, T, V = logits.shape
    fp32_loss = F.cross_entropy(logits.view(B * T, V), y.view(B * T))  # []
    # bf16 keeps 8 mantissa bits: ~2-3 significant digits
    assert loss.item() == pytest.approx(fp32_loss.item(), rel=1e-2)


def test_full_val_loss_is_batch_loss_over_all_windows(
    model: GPT, cfg: GPTConfig, ids: Tensor
):
    val_data = ids[:100]  # [100]
    T = cfg.block_size
    n_windows = (len(val_data) - 1) // T
    xs = val_data[: n_windows * T].view(n_windows, T)  # [W, T]
    ys = val_data[1 : n_windows * T + 1].view(n_windows, T)  # [W, T]
    all_at_once = batch_loss(model, xs, ys).item()
    assert full_val_loss(model, val_data, batch_size=1000) == pytest.approx(
        all_at_once, rel=1e-5
    )


@pytest.mark.parametrize("batch_size", [1, 3, 5, 12])
def test_full_val_loss_does_not_depend_on_batch_size(
    model: GPT, ids: Tensor, batch_size: int
):
    val_data = ids[:100]  # [100]
    one_batch = full_val_loss(model, val_data, batch_size=1000)
    assert full_val_loss(model, val_data, batch_size=) == pytest.approx(
        one_batch, rel=1e-5
    )


def test_full_val_loss_needs_more_than_one_window(model: GPT, cfg: GPTConfig):
    too_short = torch.arange(cfg.block_size)  # [T]
    with pytest.raises(AssertionError, match="need more than block_size 8"):
        full_val_loss(model, too_short, batch_size=4)


def test_sampled_train_loss_is_mean_of_random_batches(
    model: GPT, cfg: GPTConfig, ids: Tensor
):
    # same seed twice: draw the exact batches sampled_train_loss drew
    torch.manual_seed(0)
    sampled = sampled_train_loss(model, ids, batch_size=4, iters=5)
    torch.manual_seed(0)
    batches = [  # 5 x (x, y), each [4, T]
        get_batch(ids, batch_size=4, block_size=cfg.block_size) for _ in range(5)
    ]
    losses = [batch_loss(model, x, y) for x, y in batches]  # 5 x []
    expected = torch.stack(losses).mean()  # []
    assert sampled == pytest.approx(expected.item(), rel=1e-5)


@pytest.mark.parametrize("training", [True, False])
def test_evaluation_restores_mode(model: GPT, ids: Tensor, training: bool):
    model.train(training)
    full_val_loss(model, ids, batch_size=4)
    assert model.training is training
    sampled_train_loss(model, ids, batch_size=4, iters=2)
    assert model.training is training


# lr_at's settings; spread into it as **lr_cfg. Steps 0 .. 99 run: warmup on
# 0 .. 4, decay on 5 .. 99
lr_cfg = (warmup_steps=5, max_steps=100, max_lr=1e-2, min_lr=1e-3)


def test_warmup_starts_at_one_step_and_reaches_max_lr():
    (warmup_steps=, max_lr=) = lr_cfg
    # step 0 already takes one warmup step: 1e-2 / 5
    assert lr_at(0, **lr_cfg) == max_lr / warmup_steps
    assert lr_at(0, **lr_cfg) == 2.0e-3
    assert lr_at(warmup_steps - 1, **lr_cfg) == pytest.approx(max_lr)


def test_decay_starts_at_max_lr_and_ends_at_min_lr():
    (warmup_steps=, max_steps=, max_lr=, min_lr=) = lr_cfg
    # no jump where warmup ends
    assert lr_at(warmup_steps, **lr_cfg) == pytest.approx(max_lr)
    last_step = max_steps - 1
    # the last step that runs: cos(pi) is exactly -1, so exactly min_lr
    assert lr_at(last_step, **lr_cfg) == min_lr
    assert lr_at(last_step, **lr_cfg) == 1e-3
    assert lr_at(max_steps, **lr_cfg) == min_lr  # past the run, it stays there


def test_lr_rises_through_warmup_then_only_falls():
    (warmup_steps=, max_steps=) = lr_cfg
    warmup = [lr_at(s, **lr_cfg) for s in range(warmup_steps)]
    decay = [lr_at(s, **lr_cfg) for s in range(warmup_steps, max_steps)]
    assert all(a < b for a, b in pairwise(warmup))
    assert all(a > b for a, b in pairwise(decay))


def test_cosine_is_halfway_at_the_midpoint_of_decay():
    (warmup_steps=, max_steps=, max_lr=, min_lr=) = lr_cfg
    midpoint = (warmup_steps + max_steps - 1) // 2  # 52, halfway through 5 .. 99
    assert lr_at(midpoint, **lr_cfg) == pytest.approx((max_lr + min_lr) / 2)
    assert lr_at(midpoint, **lr_cfg) == pytest.approx(5.5e-3)


def test_warmup_must_leave_steps_to_decay():
    # 11 steps run (0 .. 10) and warmup takes 0 .. 9: step 10 alone can't decay
    no_decay = lr_cfg._replace(warmup_steps=10, max_steps=11)
    with pytest.raises(
        AssertionError, match="warmup_steps 10 leaves no decay before step 10"
    ):
        lr_at(0, **no_decay)


def names(model: GPT, params: list[torch.nn.Parameter]) -> list[str]:
    # each parameter's name in the model, matched by identity
    return [name for name, p in model.named_parameters() if any(p is q for q in params)]


def test_matrices_decay_and_vectors_dont(cfg: GPTConfig):
    one_block = GPT(cfg._replace(n_layer=1))  # every name fits on the page
    decay, no_decay = param_groups(one_block, weight_decay=0.1)
    assert decay["weight_decay"] == 0.1
    assert no_decay["weight_decay"] == 0.0
    # the embeddings and every linear weight; lm_head.weight is the token
    # embedding (tied), so it's in once, under the embedding's name
    assert names(one_block, decay["params"]) == [
        "token_embedding_table.weight",
        "position_embedding_table.weight",
        "blocks.0.attn.qkv.weight",
        "blocks.0.attn.proj.weight",
        "blocks.0.ffwd.up.weight",
        "blocks.0.ffwd.down.weight",
    ]
    # biases and both LayerNorm vectors (scale is .weight, shift is .bias);
    # qkv has no bias
    assert names(one_block, no_decay["params"]) == [
        "blocks.0.ln1.weight",
        "blocks.0.ln1.bias",
        "blocks.0.ln2.weight",
        "blocks.0.ln2.bias",
        "blocks.0.attn.proj.bias",
        "blocks.0.ffwd.up.bias",
        "blocks.0.ffwd.down.bias",
        "ln_f.weight",
        "ln_f.bias",
    ]


def test_every_parameter_is_in_exactly_one_group(model: GPT):
    decay, no_decay = param_groups(model, weight_decay=0.1)
    grouped = names(model, decay["params"]) + names(model, no_decay["params"])
    every = [name for name, _ in model.named_parameters()]
    assert sorted(grouped) == sorted(every)


def left_after_decay(lrs: list[float], *, weight_decay: float) -> float:
    # a weight the loss doesn't care about: its gradient is always 0, so Adam's
    # update is 0 and only the decay moves it. Starts at 1, so what's returned is
    # the fraction left
    w = torch.nn.Parameter(torch.ones(4))
    opt = torch.optim.AdamW([w], weight_decay=)
    for lr in lrs:
        opt.param_groups[0]["lr"] = lr
        w.grad = torch.zeros_like(w)  # 0, not None: AdamW skips a None grad
        opt.step()
    return w[0].item()


# explaination in src/notes/weight_decay.md
def test_decay_alone_shrinks_a_weight_by_24_percent_over_mains_run():
    # main's schedule and weight decay
    schedule = (warmup_steps=100, max_steps=5000, max_lr=1e-3, min_lr=1e-4)
    weight_decay = 0.1
    lrs = [lr_at(s, **schedule) for s in range(schedule.max_steps)]
    left = left_after_decay(lrs, weight_decay=)
    # each step multiplies w by (1 - lr * weight_decay); over the run that's
    # e^(-weight_decay * sum of lrs), and the sum is steps x the average lr
    assert left == pytest.approx(math.exp(-weight_decay * sum(lrs)), rel=1e-4)
    # the same in numbers: the average lr is ~5.5e-4, the cosine's midpoint
    # between 1e-3 and 1e-4, and 76% of the weight is left: 24% decayed away
    assert sum(lrs) / len(lrs) == pytest.approx(5.5e-4, rel=1e-2)
    assert left == pytest.approx(0.76, abs=1e-2)

    # twice the steps, same lr range: the cosine is stretched, its average lr
    # stays the same, so the sum of lrs doubles (warmup is still 100 steps, so
    # not quite) and so does the exponent. What's left is squared: 0.76^2
    longer = schedule._replace(max_steps=2 * schedule.max_steps)
    longer_lrs = [lr_at(s, **longer) for s in range(longer.max_steps)]
    longer_left = left_after_decay(longer_lrs, weight_decay=)
    assert sum(longer_lrs) / len(longer_lrs) == pytest.approx(5.5e-4, rel=1e-2)
    assert sum(longer_lrs) == pytest.approx(2 * sum(lrs), rel=1e-2)
    assert longer_left == pytest.approx(left**2, rel=1e-2)
    # the same in numbers: 58% left, 42% decayed away
    assert longer_left == pytest.approx(0.58, abs=1e-2)


# a short run on the trivially learnable ids
train_cfg: TrainConfig = (
    batch_size=16, max_steps=60,
    max_lr=1e-2, min_lr=1e-3,
    weight_decay=0.1,
    warmup_steps=5,
    eval_interval=20,
    eval_iters=5,
)


def test_history_has_one_entry_per_eval(model: GPT, ids: Tensor):
    history = train(model, split(ids), train_cfg)
    (max_steps=, eval_interval=) = train_cfg
    # every eval_interval steps inside the loop, then once more after the last step
    eval_steps = [*range(0, max_steps, eval_interval), max_steps]
    assert [h.step for h in history] == eval_steps
    # the same in numbers
    assert eval_steps == [0, 20, 40, 60]


def test_training_lowers_val_loss(model: GPT, ids: Tensor):
    history = train(model, split(ids), train_cfg)
    first, last = history[0], history[-1]
    assert last.val_loss < first.val_loss / 2  # starts near ln(20) = 3.0


def test_train_steps_with_the_scheduled_lr(model: GPT, ids: Tensor):
    # each eval records the lr the optimizer used for its latest step
    history = train(model, split(ids), train_cfg)
    (warmup_steps=, max_steps=, max_lr=, min_lr=, eval_interval=) = (
        train_cfg
    )
    # an eval inside the loop follows setting its step's lr; the final eval, after
    # the loop, still holds the last step's (max_steps - 1)
    lr_steps = [*range(0, max_steps, eval_interval), max_steps - 1]
    expected = [
        lr_at(s, warmup_steps=, max_steps=, max_lr=, min_lr=)
        for s in lr_steps
    ]
    assert [h.lr for h in history] == pytest.approx(expected)
    # the same in numbers: warmup 5 steps to 1e-2, then cosine down to exactly
    # min_lr (1e-3) on step 59, the last step
    assert lr_steps == [0, 20, 40, 59]
    lrs = [h.lr for h in history]
    assert lrs == pytest.approx([2.0e-3, 8.393e-3, 3.480e-3, 1.0e-3], rel=1e-3)


def test_the_last_eval_holds_the_last_steps_lr_not_the_last_evals(
    model: GPT, ids: Tensor
):
    # 19 steps, an eval every 4: evals at 16 and 19 are 3 steps apart, but their
    # lrs are steps 16 and 18: the final eval sees the last step's lr (18)
    short_cfg = train_cfg._replace(max_steps=19, eval_interval=4)
    history = train(model, split(ids), short_cfg)
    assert [h.step for h in history] == [0, 4, 8, 12, 16, 19]
    (warmup_steps=, max_steps=, max_lr=, min_lr=) = short_cfg
    lr_steps = [0, 4, 8, 12, 16, 18]
    expected = [
        lr_at(s, warmup_steps=, max_steps=, max_lr=, min_lr=)
        for s in lr_steps
    ]
    lrs = [h.lr for h in history]
    assert lrs == pytest.approx(expected)
    # in numbers: step 4 ends the 5-step warmup at 1e-2, then the decay reaches
    # min_lr (1e-3) on step 18, the last step
    assert lrs == pytest.approx(
        [2.0e-3, 1.0e-2, 8.868e-3, 4.958e-3, 1.515e-3, 1.0e-3], rel=1e-3
    )
