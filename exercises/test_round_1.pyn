# round 1: parameter counts, the lr schedule, causal attention, softmax and
# cross entropy by hand. replace each ___ with your answer, worked out on paper
# before running, and fill in my_attention, my_softmax and my_cross_entropy
# until their tests pass. the last section, why attention needs positions and
# how a position table and RoPE give them, is worked out already
import torch
import torch.nn.functional as F
from einops import rearrange
from torch import Tensor, nn

from model import GPT, GPTConfig, apply_rope, rope_angles
from train import lr_at


def n_params(module: nn.Module) -> int:
    return sum(p.numel() for p in module.parameters())


def test_predict_param_counts():
    cfg: GPTConfig = (
        vocab_size=10, block_size=8, n_embed=16, n_head=2, n_layer=2, dropout=0.0
    )
    model = GPT(cfg)
    (vocab_size=V, n_embed=E, n_layer=) = cfg
    tok_embed = V * E
    assert n_params(model.token_embedding_table) == tok_embed
    # no position table, because RoPE rotates q and k by fixed angles
    # norm1, attention (qkv and proj), norm2, feed-forward (up and down)
    # rms-norm: weight: [E], no bias
    # linear: weight: [out, in] + bias: [out]
    norm1 = E
    qkv = E * 3 * E  # bias=False
    proj = E * E + E
    attn = qkv + proj
    norm2 = E
    up = E * 4 * E + 4 * E
    down = 4 * E * E + E
    ffwd = up + down
    block = norm1 + attn + norm2 + ffwd
    assert n_params(model.blocks[0]) == block
    norm_f = E
    assert n_params(model.norm_f) == norm_f
    # the whole model; think about what lm_head adds
    lm_head = 0  # because weights are tied with token_embedding_table, and bias=False
    total = tok_embed + n_layer * block + norm_f + lm_head
    assert n_params(model) == total


def test_predict_lr_schedule():
    warmup_steps = 4
    max_steps = 10
    max_lr = 1.0
    min_lr = 0.1
    schedule = (warmup_steps=, max_steps=, max_lr=, min_lr=)
    assert lr_at(0, schedule=) == max_lr * 1 / warmup_steps
    assert lr_at(3, schedule=) == max_lr
    assert lr_at(4, schedule=) == max_lr
    assert lr_at(9, schedule=) == min_lr
    assert lr_at(10, schedule=) == min_lr


def my_attention(q: Tensor, k: Tensor, v: Tensor) -> Tensor:
    # q, k, v: [B, nh, T, hs]
    # out: [B, nh, T, hs]
    # causal, no dropout, same as F.scaled_dot_product_attention with
    # is_causal=True; plain tensor ops only
    B, nh, T, hs = q.shape
    scores: Tensor = (
        q @ rearrange(k, "B nh T hs -> B nh hs T") * hs**-0.5
    )  # [B, nh, T, T]
    causal = torch.ones(T, T, dtype=torch.bool, device=q.device).tril()
    scores = scores.masked_fill(~causal, -torch.inf)
    weights = F.softmax(scores, dim=-1)
    out = weights @ v  # [B, nh, T, hs]
    return out


def test_my_attention_matches_sdpa():
    B, nh, T, hs = 2, 3, 5, 4
    q = torch.randn(B, nh, T, hs)
    k = torch.randn(B, nh, T, hs)
    v = torch.randn(B, nh, T, hs)
    expected = F.scaled_dot_product_attention(q, k, v, is_causal=True)
    assert torch.allclose(my_attention(q, k, v), expected, atol=1e-6)


def softmax_simple(x: Tensor, dim: int = -1) -> Tensor:
    # textbook form, exp then normalize; exp overflows for large x
    exp = x.exp()
    return exp / exp.sum(dim=dim, keepdim=True)


def my_softmax(x: Tensor, dim: int = -1) -> Tensor:
    # x: [N, V]
    # out: [N, V], each row sums to 1, same as F.softmax; plain tensor ops
    # only, and stable for large x
    m = x.max(dim=dim, keepdim=True).values
    e = (x - m).exp()  # subtracting the max: exp() now peaks at exp(0) == 1
    return e / e.sum(dim=dim, keepdim=True)


def test_my_softmax_matches_torch():
    N, V = 6, 10
    logits = torch.randn(N, V)
    expected = F.softmax(logits, dim=-1)
    assert torch.allclose(my_softmax(logits, dim=-1), expected, atol=1e-6)
    # exp(1000) overflows float32, so a softmax that doesn't shift x gives nan
    big_logits = logits * 1000
    expected = F.softmax(big_logits, dim=-1)
    assert torch.allclose(my_softmax(big_logits, dim=-1), expected, atol=1e-6)


def test_softmax_simple_matches_torch_until_exp_overflows():
    N, V = 6, 10
    logits = torch.randn(N, V)
    expected = F.softmax(logits, dim=-1)
    assert torch.allclose(softmax_simple(logits, dim=-1), expected, atol=1e-6)
    # the row's max logit is in the hundreds, exp of it is inf, and inf / inf
    # is nan
    big_logits = logits * 1000
    assert torch.isfinite(F.softmax(big_logits, dim=-1)).all()
    assert softmax_simple(big_logits, dim=-1).isnan().any()


def cross_entropy_simple(logits: Tensor, targets: Tensor) -> Tensor:
    # textbook form, softmax then log; a prob that underflows to 0 logs to -inf
    N, V = logits.shape
    exp = torch.exp(logits - logits.max(dim=-1, keepdim=True).values)
    probs = exp / exp.sum(dim=-1, keepdim=True)
    log_probs = torch.log(probs)
    correct_log_probs = log_probs[torch.arange(N), targets]
    return -correct_log_probs.mean()


def log_softmax(x: Tensor, dim: int = -1) -> Tensor:
    m = x.max(dim=dim, keepdim=True).values
    z = x - m
    return z - z.exp().sum(dim=dim, keepdim=True).log()  # log(sum(exp)) done stably


def my_cross_entropy(logits: Tensor, targets: Tensor) -> Tensor:
    # logits: [N, V]
    # targets: [N], class indices
    # out: [], mean over N of -log softmax(logits)[target], same as
    # F.cross_entropy; plain tensor ops only, and stable for large logits
    n = targets.size(0)
    logp = log_softmax(logits, dim=-1)  # [N, V]
    # ignored targets are not valid columns, so clamp them and drop them after
    picked = logp[torch.arange(n), targets]  # [N], the true class's log-prob
    return -picked.mean()


def test_my_cross_entropy_matches_torch():
    N, V = 6, 10
    logits = torch.randn(N, V)
    targets = torch.randint(V, (N,))
    expected = F.cross_entropy(logits, targets)
    assert torch.allclose(my_cross_entropy(logits, targets), expected, atol=1e-6)
    # exp(1000) overflows float32, so a naive softmax gives inf/nan here
    big_logits = logits * 1000
    expected = F.cross_entropy(big_logits, targets)
    assert torch.allclose(my_cross_entropy(big_logits, targets), expected, atol=1e-3)


def test_cross_entropy_simple_matches_torch_until_probs_underflow():
    N, V = 6, 10
    logits = torch.randn(N, V)
    targets = torch.randint(V, (N,))
    expected = F.cross_entropy(logits, targets)
    assert torch.allclose(cross_entropy_simple(logits, targets), expected, atol=1e-6)
    # subtracting the max stops exp overflowing, but a target that isn't the max
    # now has its prob underflow to 0, and log(0) is -inf, so the loss is inf
    # where torch's is finite
    big_logits = logits * 1000
    assert torch.isfinite(F.cross_entropy(big_logits, targets))
    assert cross_entropy_simple(big_logits, targets) == torch.inf


# attention and positions. one head with hs = E, so x needs no head split
T, E = 6, 8
reverse = torch.arange(T).flip(0)  # token order 5 .. 0
shift = 100  # positions 100 .. 105 in place of 0 .. 5

type QKVWeights = (wq: Tensor, wk: Tensor, wv: Tensor)


def random_qkv() -> QKVWeights:
    # scaled by E**-0.5 so that q and k entries stay near 1 and softmax isn't
    # saturated
    return (
        wq=torch.randn(E, E) * E**-0.5,
        wk=torch.randn(E, E) * E**-0.5,
        wv=torch.randn(E, E) * E**-0.5,
    )


def one_head_attention(
    x: Tensor,
    w: QKVWeights,
    *,
    causal: bool,
    rope: (cos: Tensor, sin: Tensor) | None = None,
) -> Tensor:
    # x: [T, E]
    # out: [T, E]
    # rope, when given, rotates q and k by their positions as FlashAttention does
    (wq=, wk=, wv=) = w
    q = rearrange(x @ wq, "T hs -> 1 1 T hs")  # [1, 1, T, hs], apply_rope's layout
    k = rearrange(x @ wk, "T hs -> 1 1 T hs")
    v = rearrange(x @ wv, "T hs -> 1 1 T hs")
    if rope is not None:
        (cos=, sin=) = rope
        q = apply_rope(q, cos, sin)
        k = apply_rope(k, cos, sin)
    out = F.scaled_dot_product_attention(q, k, v, is_causal=causal)
    return out[0, 0]  # [T, E]


def rope_at(first_pos: int) -> (cos: Tensor, sin: Tensor):
    # out: cos, sin each [T, hs/2], for positions first_pos .. first_pos + T - 1
    cos, sin = rope_angles(first_pos + T, head_size=E, device=torch.device("cpu"))
    return (cos=cos[first_pos:], sin=sin[first_pos:])


def test_attention_without_positions_only_reorders_its_outputs():
    w = random_qkv()
    x = torch.randn(T, E)
    out = one_head_attention(x, w, causal=False)
    out_of_reversed = one_head_attention(x[reverse], w, causal=False)
    # each token gets the same vector in either order, so "dog bites man" and
    # "man bites dog" are the same set of vectors
    assert torch.allclose(out_of_reversed, out[reverse], atol=1e-6)


def test_causal_attention_without_positions_gives_the_last_token_a_bag_of_words():
    w = random_qkv()
    x = torch.randn(T, E)
    # tokens 0 .. 4 reversed, the last token kept last
    last = T - 1
    shuffled = torch.cat([torch.arange(last).flip(0), torch.tensor([last])])
    out = one_head_attention(x, w, causal=True)
    out_of_shuffled = one_head_attention(x[shuffled], w, causal=True)
    # the last token sees every token and can't tell their order. the mask is
    # itself a weak position signal, because row t averages t + 1 tokens, but
    # it says nothing about the order of the tokens a row sees
    assert torch.allclose(out_of_shuffled[last], out[last], atol=1e-6)


def test_a_position_table_makes_order_matter():
    w = random_qkv()
    x = torch.randn(T, E)
    pos_emb = torch.randn(T, E)  # [T, E], a learned table, random here
    out = one_head_attention(x + pos_emb, w, causal=False)
    out_of_reversed = one_head_attention(x[reverse] + pos_emb, w, causal=False)
    assert not torch.allclose(out_of_reversed, out[reverse], atol=1e-3)


def test_rope_makes_order_matter():
    w = random_qkv()
    x = torch.randn(T, E)
    rope = rope_at(0)
    out = one_head_attention(x, w, causal=False, rope=)
    out_of_reversed = one_head_attention(x[reverse], w, causal=False, rope=)
    assert not torch.allclose(out_of_reversed, out[reverse], atol=1e-3)


def test_a_position_table_sees_where_a_phrase_is():
    w = random_qkv()
    x = torch.randn(T, E)
    pos_emb = torch.randn(shift + T, E)  # [shift + T, E]
    out_at_0 = one_head_attention(x + pos_emb[:T], w, causal=True)
    out_at_shift = one_head_attention(x + pos_emb[shift:], w, causal=True)
    # the same phrase gets different vectors at positions 0 .. 5 and 100 .. 105
    assert not torch.allclose(out_at_shift, out_at_0, atol=1e-3)


def test_rope_sees_only_how_far_apart_tokens_are():
    w = random_qkv()
    x = torch.randn(T, E)
    out_at_0 = one_head_attention(x, w, causal=True, rope=rope_at(0))
    out_at_shift = one_head_attention(x, w, causal=True, rope=rope_at(shift))
    # moving every token by the same amount keeps each distance m - n, so every
    # score and the output are unchanged. the tolerance is for fp32 cos and sin
    # of angles near 100
    assert torch.allclose(out_at_shift, out_at_0, atol=1e-4)
