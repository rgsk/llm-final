# losses, evaluation and the training loop
import math
import time
from pathlib import Path
from typing import Any

import torch
import torch.nn.functional as F
from torch import Tensor

from checkpoint import save_checkpoint
from data import DataSplit, get_batch
from logger import EvalRow, Run
from model import GPT, GPTConfig

type TrainConfig = (
    batch_size: int, max_steps: int,
    max_lr: float, min_lr: float,
    weight_decay: float,
    grad_clip: float,
    warmup_steps: int,
    eval_interval: int,
    eval_iters: int,
)


def lr_at(
    step: int,
    *,
    schedule: (..., warmup_steps: int, max_steps: int, max_lr: float, min_lr: float),
) -> float:
    (warmup_steps=, max_steps=, max_lr=, min_lr=) = schedule
    # linear warmup to max_lr, then cosine decay to min_lr on the last step train
    # runs (max_steps - 1), so min_lr is the lr the run ends with
    last_step = max_steps - 1
    assert warmup_steps < last_step, (
        f"warmup_steps {warmup_steps} leaves no decay before step {last_step}"
    )
    if step < warmup_steps:
        # step + 1 so that step 0 is already a warmup step and no step has lr 0
        return max_lr * (step + 1) / warmup_steps
    if step >= max_steps:  # past the run
        return min_lr
    progress = (step - warmup_steps) / (last_step - warmup_steps)  # 0 -> 1
    cosine = 0.5 * (1 + math.cos(math.pi * progress))  # 1 -> 0
    return min_lr + cosine * (max_lr - min_lr)


def param_groups(model: GPT, *, weight_decay: float) -> list[dict[str, Any]]:
    # AdamW's groups, split as in GPT-2 and nanoGPT. The matrices (linear and
    # embedding weights) decay; the vectors (biases, the norms' scales)
    # don't. parameters() lists the tied lm_head/embedding matrix once
    matrices = [p for p in model.parameters() if p.dim() >= 2]
    vectors = [p for p in model.parameters() if p.dim() < 2]
    return [
        {"params": matrices, "weight_decay": weight_decay},
        {"params": vectors, "weight_decay": 0.0},
    ]


def autocast(device: torch.device):
    # bf16 on GPU, chosen per op. Matmuls (attention included) run in bf16,
    # the norms and the loss in fp32, and the stored weights stay fp32.
    # bf16 has fp32's exponent range, so gradients don't underflow, hence no
    # GradScaler. Off on CPU, where bf16 is slower
    return torch.autocast(
        device.type, dtype=torch.bfloat16, enabled=device.type == "cuda"
    )


def batch_loss(model: GPT, x: Tensor, y: Tensor) -> Tensor:
    # x: [B, T]
    # y: [B, T]
    # out: []
    # mean next-token cross-entropy over all B*T positions
    with autocast(x.device):
        logits = model(x)  # [B, T, V]
        B, T, V = logits.shape
        return F.cross_entropy(logits.view(B * T, V), y.view(B * T))


def train_step(
    model: GPT, opt: torch.optim.Optimizer, x: Tensor, y: Tensor, *, grad_clip: float
) -> Tensor:
    # x: [B, T]
    # y: [B, T]
    # out: [], the gradient norm before clipping
    loss = batch_loss(model, x, y)
    opt.zero_grad()  # grads accumulate otherwise
    loss.backward()
    # treats every gradient as one long vector and scales it down to norm
    # grad_clip when it's longer, so one bad batch can't throw the weights far;
    # the direction is kept
    grad_norm = torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=grad_clip)
    opt.step()
    return grad_norm


@torch.no_grad()
def full_val_loss(model: GPT, val_data: Tensor, *, batch_size: int) -> float:
    # val_data: [N]
    # exact loss over the whole val split, from back-to-back windows, not sampled
    was_training = model.training
    model.eval()
    device = model.device
    T = model.block_size
    # -1 because the last window's targets need one id past its inputs
    n_windows = (len(val_data) - 1) // T
    assert n_windows > 0, (
        f"val_data has {len(val_data)} ids, need more than block_size {T}"
    )
    xs = val_data[: n_windows * T].view(n_windows, T)  # [W, T]
    ys = val_data[1 : n_windows * T + 1].view(n_windows, T)  # [W, T]
    # summed on the device, so no host sync per batch
    total = torch.tensor(0.0, device=)
    count = 0
    for i in range(0, n_windows, batch_size):
        x = xs[i : i + batch_size].to(device)  # [b, T]
        y = ys[i : i + batch_size].to(device)  # [b, T]
        # weight by token count so a smaller last batch doesn't skew the mean
        total += batch_loss(model, x, y) * y.numel()
        count += y.numel()
    model.train(was_training)  # restore the caller's mode
    return (total / count).item()


@torch.no_grad()
def sampled_train_loss(
    model: GPT, train_data: Tensor, *, batch_size: int, iters: int
) -> float:
    # train_data: [N]
    # the train split is too big for a full pass, so average a few random batches
    was_training = model.training
    model.eval()
    losses: list[Tensor] = []
    for _ in range(iters):
        x, y = get_batch(
            train_data, batch_size=,
            block_size=model.block_size,
            device=model.device,
        )
        losses.append(batch_loss(model, x, y))
    model.train(was_training)
    return torch.stack(losses).mean().item()  # one sync, not one per batch


def train(
    model: GPT,
    *,
    data: DataSplit,
    train_cfg: TrainConfig,
    save_best: (path: Path, gpt_cfg: GPTConfig) | None = None,
    run: Run | None = None,
):
    # AdamW, evaluated every eval_interval steps and once at the end
    (train_data=, val_data=) = data
    (
        batch_size=, max_steps=, max_lr=, weight_decay=, grad_clip=,
        eval_interval=, eval_iters=,
    ) = train_cfg
    groups = param_groups(model, weight_decay=)
    opt = torch.optim.AdamW(groups, lr=max_lr)  # lr overwritten each step
    history: list[EvalRow] = []
    best_val_loss = math.inf
    best_step = 0
    # the largest pre-clip grad norm since the last eval, so a spike shows even
    # when it falls between evals. Kept on the device, so no host sync per step
    max_grad_norm = torch.tensor(0.0, device=model.device)
    start = time.perf_counter()

    def evaluate(step: int):
        nonlocal best_val_loss, best_step, max_grad_norm
        train_loss = sampled_train_loss(
            model, train_data, batch_size=, iters=eval_iters
        )
        val_loss = full_val_loss(model, val_data, batch_size=)
        lr: float = opt.param_groups[0]["lr"]  # the lr of the latest step
        # nan at step 0 because no step has run yet
        grad_norm = max_grad_norm.item() if step > 0 else math.nan
        max_grad_norm = torch.tensor(0.0, device=model.device)
        row: EvalRow = (
            step=, lr=, train_loss=, val_loss=, grad_norm=
        )
        history.append(row)
        is_best = val_loss < best_val_loss
        # elapsed includes evaluation; .item() above already waited for the GPU
        elapsed = time.perf_counter() - start
        if run is not None:
            run.log(row, elapsed_s=elapsed)
        print(
            f"step {step:>5}  lr {lr:.2e}  train {train_loss:.3f}  val {val_loss:.3f}"
            + f"  grad {grad_norm:.2f}  {elapsed:6.1f}s"
            + ("  *" if is_best else "")
        )
        if is_best:
            best_val_loss = val_loss
            best_step = step
            # at every new best, not only at the end, because val can rise
            # again before the last step
            if save_best is not None:
                (path=, gpt_cfg=) = save_best
                save_checkpoint(path, model, gpt_cfg, step=, val_loss=)

    model.train()
    for step in range(max_steps):
        lr = lr_at(step, schedule=train_cfg)
        for group in opt.param_groups:
            group["lr"] = lr
        if step % eval_interval == 0:
            evaluate(step)
        x, y = get_batch(
            train_data, batch_size=,
            block_size=model.block_size,
            device=model.device,
        )
        grad_norm = train_step(model, opt, x, y, grad_clip=)
        max_grad_norm = torch.maximum(max_grad_norm, grad_norm)
    evaluate(max_steps)
    if run is not None:
        total_time_s = time.perf_counter() - start
        run.summary(best_val_loss=, best_step=, total_time_s=)
    return history


if __name__ == "__main__":
    from data import split
    from paths import SHAKESPEARE
    from tokenizer import CharTokenizer

    torch.manual_seed(1337)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    text = SHAKESPEARE.read_text()
    tok = CharTokenizer(text)
    ids = torch.tensor(tok.encode(text), dtype=torch.long)  # [N]
    data = split(ids)

    gpt_cfg = (
        vocab_size=tok.vocab_size, block_size=64,
        n_embed=128, n_head=4, n_layer=4,
        dropout=0.0,
    )
    train_cfg: TrainConfig = (
        batch_size=32, max_steps=500,
        max_lr=3e-3, min_lr=3e-4,
        weight_decay=0.1,
        grad_clip=1.0,
        warmup_steps=10,
        eval_interval=100,
        eval_iters=20,
    )
    model = GPT(gpt_cfg).to(device)
    # the step-0 val loss should start near ln(V), then fall
    print(f"{device}  uniform loss {math.log(tok.vocab_size):.3f}")
    history = train(model, data=, train_cfg=)
    print(f"val {history[0].val_loss:.3f} -> {history[-1].val_loss:.3f}")
