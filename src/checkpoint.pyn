# a checkpoint file: a GPT's weights plus the config that rebuilds it, so loading
# needs nothing but the file
from pathlib import Path

import torch
from byname import record

from model import GPT, GPTConfig


def save_checkpoint(
    path: Path, model: GPT, gpt_cfg: GPTConfig, *, step: int, val_loss: float
) -> None:
    # the config goes in as a plain dict: weights_only loading refuses
    # arbitrary classes, records included
    ckpt = {
        "model": model.state_dict(),
        "gpt_cfg": gpt_cfg._asdict(),
        "step": step,
        "val_loss": val_loss,
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    # write aside, then rename: a crash mid-write leaves the old file intact
    tmp = path.with_suffix(".tmp")
    torch.save(ckpt, tmp)
    tmp.replace(path)


def load_checkpoint(
    path: Path, *, device: str | torch.device = "cpu"
) -> (model: GPT, gpt_cfg: GPTConfig, step: int, val_loss: float):
    # weights_only: unpickle tensors and plain containers, never arbitrary code
    ckpt = torch.load(path, map_location=device, weights_only=True)
    # names and types checked at runtime: a file saved before a GPTConfig field
    # existed raises here, naming the missing field
    gpt_cfg = record(GPTConfig, ckpt["gpt_cfg"])
    # rebuild the architecture from the file, then fill in its weights
    model = GPT(gpt_cfg).to(device)
    model.load_state_dict(ckpt["model"])  # strict: a missing or extra key raises
    return (model=, gpt_cfg=, step=ckpt["step"], val_loss=ckpt["val_loss"])
