# end to end on tiny shakespeare: tokenize, split, train a GPT, then sample from it
import torch

from data import split
from generate import generate
from model import GPT
from paths import SHAKESPEARE
from tokenizer import CharTokenizer
from train import TrainConfig, train

if __name__ == "__main__":
    torch.manual_seed(1337)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    text = SHAKESPEARE.read_text()
    tok = CharTokenizer(text)
    ids = torch.tensor(tok.encode(text), dtype=torch.long)  # [N]
    data = split(ids)

    gpt_cfg = (
        vocab_size=tok.vocab_size, block_size=128, n_embed=192, n_head=6, n_layer=6
    )
    train_cfg: TrainConfig = (
        batch_size=64, max_steps=2000, lr=1e-3, eval_interval=250, eval_iters=20
    )
    model = GPT(gpt_cfg).to(device)
    train(model, data, train_cfg)

    # start from a single newline; 500 new chars runs well past block_size
    prompt = torch.tensor([tok.encode("\n")], device=device)  # [1, 1]
    out = generate(model, prompt, max_new_tokens=500)  # [1, 501]
    print(tok.decode(out[0].tolist()))
