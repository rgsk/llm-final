# end to end on tiny shakespeare. Tokenize, split, train a GPT, then sample from
# the best checkpoint
import torch

from checkpoint import load_checkpoint
from data import split
from generate import generate
from logger import Run
from model import GPT
from paths import CKPT_DIR, SHAKESPEARE
from tokenizer import CharTokenizer
from train import TrainConfig, train

if __name__ == "__main__":
    torch.manual_seed(1337)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    # tf32: float32 matmuls on tensor cores, rounding inputs to 10 mantissa bits
    torch.set_float32_matmul_precision("high")
    text = SHAKESPEARE.read_text()
    tok = CharTokenizer(text)
    ids = torch.tensor(tok.encode(text), dtype=torch.long)  # [N]
    data = split(ids)

    gpt_cfg = (
        vocab_size=tok.vocab_size, block_size=128,
        n_embed=192, n_head=6, n_layer=6,
        dropout=0.2,
    )
    train_cfg: TrainConfig = (
        batch_size=64, max_steps=5000,
        max_lr=1e-3, min_lr=1e-4,
        weight_decay=0.1,
        grad_clip=1.0,
        warmup_steps=100,
        eval_interval=250,
        eval_iters=20,
    )
    model = GPT(gpt_cfg).to(device)
    ckpt_path = CKPT_DIR / "main.pt"
    # every hyperparameter, for wandb's config table
    config = {**gpt_cfg, **train_cfg}
    with Run("main", config) as run:
        train(
            model, data=, train_cfg=,
            save_best=(path=ckpt_path, gpt_cfg=),
            run=,
        )
        run.log_checkpoint(ckpt_path)  # the best, since save_best overwrote the rest

        # inside the run, so the sample lands in its .log too.
        # the best val loss can come before the last step, so sample from that model
        (model=, step=, val_loss=) = load_checkpoint(ckpt_path, device=)
        print(f"best checkpoint: step {step}, val {val_loss:.3f}")

        # start from a single newline; 500 new chars runs well past block_size
        prompt = torch.tensor([tok.encode("\n")], device=)  # [1, 1]
        out = generate(model, prompt, max_new_tokens=500)  # [1, 501]
        print(tok.decode(out[0].tolist()))
